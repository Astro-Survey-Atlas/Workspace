{
  "name": "asa-workspace",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/cli"
  ],
  "description": "Atlas user-asset workspace and MCP service",
  "scripts": {
    "build": "npm run build:server && npm run build:viewer && npm run build:cli",
    "build:server": "tsc -p tsconfig.json && cp src/sky-point-coordinates.py src/workflow-catalog-fits.py src/workflow-fits-cutout.py src/scan-fits-catalog.py src/workflow_catalog_helpers.py dist/src/",
    "build:viewer": "tsc -p tsconfig.viewer.json --noEmit && vite build",
    "build:cli": "npm run build --workspace @astro-workspace/cli",
    "dev": "tsx src/http-server.ts",
    "dev:viewer": "vite --host 0.0.0.0 --port 5173",
    "preview:viewer": "vite preview --host 0.0.0.0 --port 4173",
    "start": "node dist/src/http-server.js",
    "test": "tsx --test --test-concurrency=4 test/*.test.ts",
    "test:e2e": "playwright test",
    "verify": "npm run verify:types && npm run build && npm test && npm run verify:chart",
    "verify:types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.viewer.json --noEmit",
    "verify:chart": "helm lint charts/asa-workspace --strict && helm template charts/asa-workspace > /dev/null",
    "smoke:http": "tsx scripts/mcp-http-smoke.ts",
    "smoke:workflow-real": "tsx scripts/smoke_real_workflow.ts",
    "validate": "npm run build && npm test",
    "scan:worker": "node dist/src/scan-worker.js"
  },
  "dependencies": {
    "@astro-survey-atlas/sky-globe": "file:../Astro-Survey-Atlas-Assets/packages/sky-globe",
    "@aws-sdk/client-s3": "^3.1095.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-undici": "0.34.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "aladin-lite": "^3.9.0-beta",
    "ali-oss": "^6.23.0",
    "compression": "^1.8.2",
    "csv-parse": "7.0.3",
    "express": "^5.1.0",
    "healpixjs": "^2.0.0",
    "lucide": "^1.25.0",
    "three": "^0.185.1",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace": "3.0.0",
    "@playwright/test": "^1.61.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "pngjs": "^7.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
