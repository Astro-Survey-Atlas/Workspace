{
  "name": "astro-data-workspace",
  "version": "0.10.38",
  "private": true,
  "type": "module",
  "description": "Atlas user-asset workspace and MCP service",
  "scripts": {
    "build": "npm run build:server && npm run build:viewer",
    "build:server": "tsc -p tsconfig.json",
    "build:viewer": "tsc -p tsconfig.viewer.json --noEmit && vite build",
    "dev": "tsx src/http-server.ts",
    "dev:viewer": "vite --host 0.0.0.0 --port 5173",
    "start": "node dist/src/http-server.js",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "playwright test",
    "smoke:http": "tsx scripts/mcp-http-smoke.ts",
    "smoke:local-scan": "tsx scripts/smoke_local_csv_scan.ts",
    "smoke:workflow-real": "tsx scripts/smoke_real_workflow.ts",
    "validate": "npm run build && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "aladin-lite": "^3.9.0-beta",
    "ali-oss": "^6.23.0",
    "csv-parse": "7.0.1",
    "express": "^5.1.0",
    "healpixjs": "^2.0.0",
    "lucide": "^1.25.0",
    "pg": "^8.16.3",
    "three": "^0.185.1",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.185.1",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.0",
    "pngjs": "^7.0.0",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
