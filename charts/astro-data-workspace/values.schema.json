{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "metadataStore": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["sqlite", "bundled-postgresql", "external-postgresql"] },
        "sqlite": {
          "type": "object",
          "properties": { "path": { "type": "string", "pattern": "^/state/.+" } },
          "required": ["path"]
        },
        "external": {
          "type": "object",
          "properties": {
            "existingSecret": { "type": "string" },
            "existingSecretKey": { "type": "string", "minLength": 1 }
          }
        }
      },
      "required": ["mode"]
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "size": { "type": "string", "minLength": 1 }
      },
      "required": ["enabled", "existingClaim"]
    },
    "localData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": { "type": "string", "pattern": "^$|^[^\\s/]+$" },
            "path": {
              "type": "string",
              "pattern": "^$|^/.+$",
              "not": { "anyOf": [
                { "pattern": "(^|/)\\.{1,2}(/|$)" },
                { "pattern": "^/+$" }
              ] }
            }
          },
          "required": ["server", "path"]
        },
        "hostPath": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^$|^/.+$",
              "not": { "anyOf": [
                { "pattern": "(^|/)\\.{1,2}(/|$)" },
                { "pattern": "^/+$" }
              ] }
            },
            "type": { "type": "string", "enum": ["Directory"] }
          },
          "required": ["path", "type"]
        },
        "nodeSelector": {
          "type": "object",
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["enabled", "existingClaim", "nfs", "hostPath", "nodeSelector"],
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": false } } },
          "then": {
            "properties": {
              "existingClaim": { "const": "" },
              "nfs": { "const": { "server": "", "path": "" } },
              "hostPath": { "const": { "path": "", "type": "Directory" } },
              "nodeSelector": { "maxProperties": 0 }
            }
          }
        },
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "existingClaim": { "minLength": 1 },
                  "nfs": { "const": { "server": "", "path": "" } },
                  "hostPath": { "const": { "path": "", "type": "Directory" } }
                }
              },
              {
                "properties": {
                  "existingClaim": { "const": "" },
                  "nfs": {
                    "properties": {
                      "server": { "minLength": 1 },
                      "path": { "minLength": 1, "pattern": "^/.+$", "not": { "anyOf": [ { "pattern": "(^|/)\\.{1,2}(/|$)" }, { "pattern": "^/+$" } ] } }
                    }
                  },
                  "hostPath": { "const": { "path": "", "type": "Directory" } }
                }
              },
              {
                "properties": {
                  "existingClaim": { "const": "" },
                  "nfs": { "const": { "server": "", "path": "" } },
                  "hostPath": {
                    "properties": {
                      "path": { "minLength": 1, "pattern": "^/.+$", "not": { "anyOf": [ { "pattern": "(^|/)\\.{1,2}(/|$)" }, { "pattern": "^/+$" } ] } },
                      "type": { "const": "Directory" }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["bundled", "external"] },
        "localScanEnabled": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 500, "maximum": 120000 },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "file": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
            "object": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
            "coverage": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[a-z0-9][a-z0-9._-]*$" }
          },
          "required": ["file", "object", "coverage"]
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            },
            "existingSecretKey": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$" }
          },
          "required": ["existingSecret", "existingSecretKey"]
        },
        "initJob": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "repository": { "type": "string", "minLength": 1 },
                "tag": { "type": "string", "minLength": 1, "not": { "const": "latest" } },
                "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
              },
              "required": ["repository", "tag", "pullPolicy"]
            },
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 120 },
            "retryIntervalSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
            "resources": { "type": "object" }
          },
          "required": ["image", "maxAttempts", "retryIntervalSeconds", "resources"]
        }
      },
      "required": ["mode", "localScanEnabled", "index", "external", "initJob"]
    },
    "dataWarehouse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "namespace": {
          "type": "string",
          "minLength": 0,
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "pollIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
        "elasticsearch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "maxLength": 2048 },
            "existingSecret": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            },
            "existingSecretKey": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9._-]+$" },
            "layerIndex": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
            "fileIndex": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[a-z0-9][a-z0-9._-]*$" },
            "coverageIndex": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[a-z0-9][a-z0-9._-]*$" }
          },
          "required": ["url", "existingSecret", "existingSecretKey", "layerIndex", "fileIndex", "coverageIndex"]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingClaim": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
            },
            "storageClass": { "type": "string", "maxLength": 253 },
            "accessModes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] }
            },
            "size": { "type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$" },
            "mountPath": {
              "type": "string",
              "minLength": 2,
              "pattern": "^/[^/].*"
            }
          },
          "required": ["existingClaim", "storageClass", "accessModes", "size", "mountPath"]
        },
        "scannerImage": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "const": "latest" } }
      },
      "required": ["enabled", "namespace", "pollIntervalMs", "elasticsearch", "evidence", "scannerImage"]
    },
    "resources": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "auth": {
          "type": "object",
          "properties": {
            "database": { "type": "string" },
            "username": { "type": "string" },
            "existingSecret": { "type": "string" },
            "secretKeys": {
              "type": "object",
              "properties": { "userPasswordKey": { "type": "string", "minLength": 1 } },
              "required": ["userPasswordKey"]
            }
          },
          "required": ["database", "username", "secretKeys"]
        }
      },
      "required": ["enabled"]
    },
    "elasticsearch": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "nameOverride": { "type": "string" },
        "fullnameOverride": { "type": "string" },
        "security": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" } },
          "required": ["enabled"]
        },
        "master": {
          "type": "object",
          "properties": {
            "masterOnly": { "type": "boolean" },
            "replicaCount": { "type": "integer", "minimum": 0 },
            "persistence": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "existingClaim": { "type": "string" },
                "size": {
                  "type": "string",
                  "pattern": "^([2-9][0-9]|[1-9][0-9]{2,})Gi$|^[1-9][0-9]*Ti$"
                }
              },
              "required": ["enabled", "existingClaim", "size"]
            }
          },
          "required": ["masterOnly", "replicaCount", "persistence"]
        },
        "data": {
          "type": "object",
          "properties": { "replicaCount": { "type": "integer", "minimum": 0 } },
          "required": ["replicaCount"]
        },
        "coordinating": {
          "type": "object",
          "properties": { "replicaCount": { "type": "integer", "minimum": 0 } },
          "required": ["replicaCount"]
        },
        "ingest": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "replicaCount": { "type": "integer", "minimum": 0 }
          },
          "required": ["enabled", "replicaCount"]
        }
      },
      "required": ["enabled", "security", "master", "data", "coordinating", "ingest"]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "metadataStore": { "properties": { "mode": { "const": "sqlite" } } } } },
      "then": {
        "properties": {
          "postgresql": { "properties": { "enabled": { "const": false } } },
          "metadataStore": { "properties": { "external": { "properties": { "existingSecret": { "const": "" } } } } }
        }
      }
    },
    {
      "if": { "properties": { "metadataStore": { "properties": { "mode": { "const": "bundled-postgresql" } } } } },
      "then": {
        "properties": {
          "postgresql": { "properties": { "enabled": { "const": true } } },
          "metadataStore": { "properties": { "external": { "properties": { "existingSecret": { "const": "" } } } } }
        }
      }
    },
    {
      "if": { "properties": { "metadataStore": { "properties": { "mode": { "const": "external-postgresql" } } } } },
      "then": {
        "properties": {
          "postgresql": { "properties": { "enabled": { "const": false } } },
          "metadataStore": {
            "required": ["external"],
            "properties": {
              "external": {
                "required": ["existingSecret", "existingSecretKey"],
                "properties": { "existingSecret": { "minLength": 1 } }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "search": { "properties": { "mode": { "const": "bundled" } } } } },
      "then": {
        "properties": {
          "search": { "properties": { "external": { "properties": { "existingSecret": { "const": "" } } } } },
          "elasticsearch": {
            "properties": {
              "enabled": { "const": true },
              "security": { "properties": { "enabled": { "const": false } } },
              "master": {
                "properties": {
                  "masterOnly": { "const": false },
                  "replicaCount": { "const": 1 },
                  "persistence": { "properties": { "enabled": { "const": true } } }
                }
              },
              "data": { "properties": { "replicaCount": { "const": 0 } } },
              "coordinating": { "properties": { "replicaCount": { "const": 0 } } },
              "ingest": {
                "properties": {
                  "enabled": { "const": false },
                  "replicaCount": { "const": 0 }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "search": { "properties": { "mode": { "const": "external" } } } } },
      "then": {
        "properties": {
          "search": {
            "properties": {
              "external": {
                "properties": { "existingSecret": { "minLength": 1 } },
                "required": ["existingSecret", "existingSecretKey"]
              }
            }
          },
          "elasticsearch": { "properties": { "enabled": { "const": false } } }
        }
      }
    },
    {
      "if": { "properties": { "dataWarehouse": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "dataWarehouse": {
            "properties": {
              "elasticsearch": {
                "oneOf": [
                  {
                    "properties": {
                      "url": { "minLength": 1 },
                      "existingSecret": { "const": "" }
                    }
                  },
                  {
                    "properties": {
                      "url": { "const": "" },
                      "existingSecret": { "minLength": 1 }
                    }
                  }
                ]
              },
              "evidence": {
                "properties": {
                  "accessModes": {
                    "contains": { "const": "ReadWriteMany" }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "dataWarehouse": { "properties": { "enabled": { "const": false } } } } },
      "then": {
        "properties": {
          "dataWarehouse": {
            "properties": {
              "elasticsearch": {
                "properties": {
                  "url": { "const": "" },
                  "existingSecret": { "const": "" }
                }
              },
              "evidence": {
                "properties": { "existingClaim": { "const": "" } }
              }
            }
          }
        }
      }
    }
  ],
  "required": ["metadataStore", "persistence", "localData", "search", "dataWarehouse", "postgresql", "elasticsearch"]
}
