{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "const": 1
    },
    "image": {
      "type": "object"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "service": {
      "type": "object"
    },
    "ingress": {
      "type": "object"
    },
    "persistence": {
      "type": "object"
    },
    "localData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "nfs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "server": {
              "type": "string",
              "pattern": "^$|^[^\\s/]+$"
            },
            "path": {
              "type": "string",
              "pattern": "^$|^/.+$",
              "not": {
                "anyOf": [
                  {
                    "pattern": "(^|/)\\.{1,2}(/|$)"
                  },
                  {
                    "pattern": "^/+$"
                  }
                ]
              }
            }
          },
          "required": [
            "server",
            "path"
          ]
        },
        "hostPath": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^$|^/.+$",
              "not": {
                "anyOf": [
                  {
                    "pattern": "(^|/)\\.{1,2}(/|$)"
                  },
                  {
                    "pattern": "^/+$"
                  }
                ]
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "Directory"
              ]
            }
          },
          "required": [
            "path",
            "type"
          ]
        },
        "nodeSelector": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "enabled",
        "existingClaim",
        "nfs",
        "hostPath",
        "nodeSelector"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "then": {
            "properties": {
              "existingClaim": {
                "const": ""
              },
              "nfs": {
                "const": {
                  "server": "",
                  "path": ""
                }
              },
              "hostPath": {
                "const": {
                  "path": "",
                  "type": "Directory"
                }
              },
              "nodeSelector": {
                "maxProperties": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "properties": {
                  "existingClaim": {
                    "minLength": 1
                  },
                  "nfs": {
                    "const": {
                      "server": "",
                      "path": ""
                    }
                  },
                  "hostPath": {
                    "const": {
                      "path": "",
                      "type": "Directory"
                    }
                  }
                }
              },
              {
                "properties": {
                  "existingClaim": {
                    "const": ""
                  },
                  "nfs": {
                    "properties": {
                      "server": {
                        "minLength": 1
                      },
                      "path": {
                        "minLength": 1,
                        "pattern": "^/.+$",
                        "not": {
                          "anyOf": [
                            {
                              "pattern": "(^|/)\\.{1,2}(/|$)"
                            },
                            {
                              "pattern": "^/+$"
                            }
                          ]
                        }
                      }
                    }
                  },
                  "hostPath": {
                    "const": {
                      "path": "",
                      "type": "Directory"
                    }
                  }
                }
              },
              {
                "properties": {
                  "existingClaim": {
                    "const": ""
                  },
                  "nfs": {
                    "const": {
                      "server": "",
                      "path": ""
                    }
                  },
                  "hostPath": {
                    "properties": {
                      "path": {
                        "minLength": 1,
                        "pattern": "^/.+$",
                        "not": {
                          "anyOf": [
                            {
                              "pattern": "(^|/)\\.{1,2}(/|$)"
                            },
                            {
                              "pattern": "^/+$"
                            }
                          ]
                        }
                      },
                      "type": {
                        "const": "Directory"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "productionData": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "storageClass": {
          "type": "string",
          "maxLength": 253
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ReadWriteOnce",
              "ReadOnlyMany",
              "ReadWriteMany",
              "ReadWriteOncePod"
            ]
          }
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "mountPath": {
          "type": "string",
          "minLength": 2,
          "pattern": "^/[^/].*"
        }
      },
      "required": [
        "enabled",
        "existingClaim",
        "storageClass",
        "accessModes",
        "size",
        "mountPath"
      ]
    },
    "downloads": {
      "type": "object"
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "bundled",
            "external"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "external": {
          "type": "object"
        },
        "bundled": {
          "type": "object"
        }
      }
    },
    "env": {
      "type": "array"
    },
    "networkProxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "url": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^$|^https?://[^/\\s@?#]+$"
        },
        "noProxy": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^,\\s]+$"
          }
        }
      },
      "required": [
        "enabled",
        "url"
      ]
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "endpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https?://[^\\s]+$"
        },
        "serviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cluster": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "metricExportIntervalMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 300000
        },
        "captureContent": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "endpoint",
        "serviceName",
        "cluster",
        "environment",
        "metricExportIntervalMs",
        "captureContent"
      ]
    },
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "paused": {
          "type": "boolean"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "containerSecurityContext": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    }
  }
}
